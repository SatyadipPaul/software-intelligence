<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.satyadippaul</groupId><artifactId>software-intelligence</artifactId><version>0.1.0</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>evaluation</artifactId>
  <url>https://github.com/SatyadipPaul/software-intelligence</url>
  <name>Grounded question harnesses</name>
  <description>
    Scores the engine against question sets whose answers were read out of the source: structural
    accuracy, evidence recall, anchor recall, recall@k and MRR, plus a naive text-search baseline and an
    oracle chooser that measures the ceiling a tree descent could reach.
  </description>
  <dependencies>
    <dependency><groupId>io.github.satyadippaul</groupId><artifactId>model</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.satyadippaul</groupId><artifactId>index-tree</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.satyadippaul</groupId><artifactId>query-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
</project>
