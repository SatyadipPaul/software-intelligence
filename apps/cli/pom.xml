<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.softwareintelligence</groupId><artifactId>software-intelligence</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>cli</artifactId>
  <name>Repository intelligence CLI</name>
  <dependencies>
    <dependency><groupId>io.softwareintelligence</groupId><artifactId>analyzer-java</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.softwareintelligence</groupId><artifactId>framework-spring</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.softwareintelligence</groupId><artifactId>architecture</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.softwareintelligence</groupId><artifactId>pipeline</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.softwareintelligence</groupId><artifactId>query-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.softwareintelligence</groupId><artifactId>evaluation</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId><version>4.7.6</version></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><archive><manifest><mainClass>io.softwareintelligence.cli.Main</mainClass></manifest></archive></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.5.3</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <finalName>repo-intel</finalName>
          <filters><filter><artifact>*:*</artifact><excludes>
            <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
          </excludes></filter></filters>
          <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>io.softwareintelligence.cli.Main</mainClass></transformer></transformers>
        </configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
