<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.satyadippaul</groupId>
  <artifactId>software-intelligence</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>Software Intelligence</name>
  <description>Evidence-first, Java-first repository intelligence: a deterministic, provenance-bearing software model.</description>
  <url>https://github.com/SatyadipPaul/software-intelligence</url>

  <licenses>
    <license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url><distribution>repo</distribution></license>
  </licenses>
  <developers>
    <developer><id>satyadippaul</id><name>Satyadip Paul</name></developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/SatyadipPaul/software-intelligence.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/SatyadipPaul/software-intelligence.git</developerConnection>
    <url>https://github.com/SatyadipPaul/software-intelligence</url>
  </scm>

  <modules>
    <module>modules/model</module>
    <module>modules/analyzer-java</module>
    <module>modules/framework-spring</module>
    <module>modules/pipeline</module>
    <module>modules/architecture</module>
    <module>modules/index-tree</module>
    <module>modules/embedding</module>
    <module>modules/query-engine</module>
    <module>modules/evaluation</module>
    <module>modules/visualization</module>
    <module>apps/cli</module>
    <module>apps/maven-plugin</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.0</junit.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution><id>require-jdk-25</id><goals><goal>enforce</goal></goals><configuration><rules>
              <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
            </rules></configuration></execution>
            <!--
              Everything published has to be open source, so every dependency that can reach a
              published artifact is named here, and nothing else may. The rule bans all coordinates
              and then permits the audited ones: a new dependency, direct or transitive, fails the
              build until someone has read its licence and added it to THIRD-PARTY-NOTICES.md. An
              inventory that is only a document drifts; this one cannot.
            -->
            <execution><id>only-audited-dependencies</id><goals><goal>enforce</goal></goals><configuration><rules>
              <bannedDependencies>
                <searchTransitive>true</searchTransitive>
                <message>Undeclared dependency on the distribution path. Everything that reaches a
                  published artifact must be open source, audited, and listed in
                  THIRD-PARTY-NOTICES.md before it is added to the allow-list in the root POM's
                  only-audited-dependencies rule.</message>
                <excludes><exclude>*</exclude></excludes>
                <includes>
                  <!-- This project. -->
                  <include>io.github.satyadippaul:*</include>
                  <!-- Eclipse JDT and the Platform and Equinox pieces it needs: EPL-2.0. -->
                  <include>org.eclipse.jdt:org.eclipse.jdt.core:3.46.0</include>
                  <include>org.eclipse.jdt:ecj:3.46.0</include>
                  <include>org.eclipse.platform:*</include>
                  <!-- OSGi service and annotation jars: Apache-2.0. -->
                  <include>org.osgi:*</include>
                  <!-- JNA: dual LGPL-2.1-or-later / Apache-2.0, Apache-2.0 elected. See NOTICE. -->
                  <include>net.java.dev.jna:jna:5.18.1</include>
                  <include>net.java.dev.jna:jna-platform:5.18.1</include>
                  <!-- Command line parsing: Apache-2.0. -->
                  <include>info.picocli:picocli:4.7.6</include>
                  <!-- Optional dense backend, never bundled: MIT. -->
                  <include>com.microsoft.onnxruntime:onnxruntime:1.20.0</include>
                  <!--
                    Test and provided scope are open, because neither reaches a published artifact:
                    a test dependency is not transitive to a consumer, and a provided one is the
                    Maven runtime's own tree, supplied by the build rather than shipped by us. The
                    rule is about what is distributed, and pinning Maven's internals here would make
                    it fail on a Maven upgrade while saying nothing about the bundle.
                  -->
                  <include>*:*:*:*:test</include>
                  <include>*:*:*:*:provided</include>
                </includes>
              </bannedDependencies>
            </rules></configuration></execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration><release>${maven.compiler.release}</release></configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!--
    Opt-in only. Central requires sources, javadoc, and signatures; this profile produces them but
    nothing here publishes on its own. Releasing is a deliberate act with the maintainer's own
    credentials: mvn -Prelease deploy.
  -->
  <profiles>
    <!-- The weights artifact joins the build exactly when weights are there to package. A clone
         builds and tests without carrying tens of megabytes of binary, and nobody has to remember
         a flag to include them once they are. -->
    <profile>
      <id>embedding-model</id>
      <activation>
        <file><exists>modules/embedding-model/src/main/resources/repo-intel/embedding/model.safetensors</exists></file>
      </activation>
      <modules><module>modules/embedding-model</module></modules>
    </profile>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.3.1</version>
            <executions><execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.8.0</version>
            <executions><execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution></executions>
            <configuration><doclint>none</doclint></configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.4</version>
            <executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
          </plugin>
          <!--
            Uploads to the Central Portal. autoPublish is deliberately false: the release lands in a
            staging area for the maintainer to inspect and release by hand. A first publish that
            goes straight to Central cannot be taken back - coordinates are immutable there.
          -->
          <plugin>
            <groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.5.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
